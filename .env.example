# Environment configuration for XXTube

# Required for Postgres-backed mode
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xxtube

# Required for JWT session cookies
JWT_SECRET=replace_this_with_a_64_char_random_string

# Optional demo mode; set to true to run without Postgres/Telegram integration
DEMO_MODE=true

# Telegram integration (optional for demo mode)
TELEGRAM_BOT_TOKEN=demo-token

# Admin panel access
ADMIN_SECRET=change_me

# Local dev server
PORT=3000
