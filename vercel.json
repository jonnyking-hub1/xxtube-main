{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/admin.html",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "/watch.html",
      "dest": "/frontend/watch.html"
    },
    {
      "src": "/auth.html",
      "dest": "/frontend/auth.html"
    },
    {
      "src": "/google-auth.html",
      "dest": "/frontend/google-auth.html"
    },
    {
      "src": "/galleries.html",
      "dest": "/frontend/galleries.html"
    },
    {
      "src": "/gallery.html",
      "dest": "/frontend/gallery.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}